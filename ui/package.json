{
	"name": "ui",
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"fmt": "prettier --log-level warn --write .",
		"test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --passWithNoTests --testPathPatterns ./src/",
		"dev": "npm run fmt && vite --port 3000",
		"build": "npm run fmt && vite build",
		"preview": "vite preview --port 4000"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "6.2.1",
		"jest": "30.2.0",
		"prettier": "3.6.2",
		"prettier-plugin-svelte": "3.4.0",
		"svelte": "5.39.11",
		"two.js": "0.7.9",
		"vite": "7.1.9"
	}
}
